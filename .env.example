# Copy to .env.local. This file contains no cloud credentials.
# Demo accounts are intentionally public and must only use fictional information.
DEMO_MODE=true
DATA_BACKEND=local

# Replace with at least 32 cryptographically random characters before deployment.
# Cloud Run deploy script injects a generated value through Secret Manager.
SESSION_SECRET=

# Optional local JSON location; default is .data/carebridge.json.
# DATA_FILE=

# Cloud Run / optional local Firestore configuration:
# DATA_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIRESTORE_DOCUMENT=carebridge/state

# Local ADC only: run gcloud auth application-default login.
# Cloud Run uses its attached runtime service account; do not package JSON keys.

# Only for testing `npm run start` over localhost HTTP, never for public HTTPS:
# SESSION_COOKIE_SECURE=false

# Cloud Run injects PORT. Docker defaults to 8080; npm dev defaults to 3000.
# PORT=8080
